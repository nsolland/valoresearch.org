{
  "schema_version": "1.0",
  "name": "BIDRA",
  "principle": "Bidra, og ikke bare gi.",
  "core": {
    "flow": [
      "purpose",
      "need",
      "contribution",
      "action",
      "verification",
      "impact",
      "feedback"
    ],
    "objects": [
      "contribution_contract",
      "contributor_profile",
      "action_record",
      "impact_record",
      "contribution_trace",
      "organization_contract",
      "campaign_contract",
      "impact_receipt"
    ]
  },
  "modules": {
    "money": {
      "unit": "currency",
      "examples": [
        "one_off",
        "recurring",
        "matching"
      ]
    },
    "time": {
      "unit": "minutes",
      "examples": [
        "volunteering",
        "microtask",
        "event"
      ]
    },
    "skills": {
      "unit": "verified_task",
      "examples": [
        "legal",
        "design",
        "medical",
        "technical"
      ]
    },
    "network": {
      "unit": "verified_connection",
      "examples": [
        "introduction",
        "employer",
        "decision_maker"
      ]
    },
    "attention": {
      "unit": "verified_action",
      "examples": [
        "share",
        "like",
        "forward",
        "read"
      ]
    },
    "equipment": {
      "unit": "accepted_resource",
      "examples": [
        "gear",
        "space",
        "devices"
      ]
    },
    "transport": {
      "unit": "verified_delivery",
      "examples": [
        "person",
        "goods",
        "local_logistics"
      ]
    },
    "advocacy": {
      "unit": "verified_action",
      "examples": [
        "petition",
        "contact",
        "public_consultation"
      ]
    }
  },
  "organization_adapter": {
    "required": [
      "purpose",
      "target_outcome",
      "accepted_contribution_types",
      "verification_rules",
      "impact_evidence"
    ],
    "optional": [
      "payment_provider",
      "crm",
      "volunteer_system",
      "campaign_system",
      "identity_provider"
    ]
  },
  "scoring": {
    "contribution_score": {
      "scope": "voluntary personal contribution history",
      "inputs": [
        "verified_money",
        "verified_time",
        "verified_skills",
        "verified_network",
        "verified_actions"
      ],
      "rules": [
        "no score for unverified activity",
        "no coercive eligibility decisions",
        "user may keep score private"
      ],
      "default_visibility": "private"
    },
    "charity_impact": {
      "scope": "documented effect attributable to a campaign or portfolio",
      "inputs": [
        "verified_outputs",
        "verified_outcomes",
        "evidence_quality",
        "cost_of_impact",
        "duration"
      ],
      "rules": [
        "separate activity from effect",
        "show uncertainty",
        "no fabricated attribution"
      ]
    },
    "organization_impact_score": {
      "scope": "organization-level conversion of mobilized resources into documented effect",
      "inputs": [
        "verified_contributions",
        "verified_actions",
        "verified_outcomes",
        "evidence_quality",
        "cost_of_impact",
        "duration"
      ],
      "activity_only_score": false,
      "rules": [
        "do not reward volume without relevance",
        "publish uncertainty",
        "separate fundraising efficiency from impact"
      ]
    }
  },
  "campaign_contract": {
    "required": [
      "target_outcome",
      "accepted_contributions",
      "verification_rules",
      "deadline",
      "failure_policy"
    ],
    "rule": "every campaign declares what success means before contributions are collected"
  },
  "impact_receipt": {
    "binds": [
      "contribution_id",
      "campaign_id",
      "action_record_id",
      "impact_record_id",
      "evidence_refs"
    ],
    "rule": "receipt shows contribution to campaign to documented effect; no effect claim without evidence"
  },
  "anti_gaming": {
    "activity_without_relevance_or_effect": "no_credit",
    "duplicate_or_self_generated_activity": "no_credit",
    "unverified_claims": "no_credit",
    "rule": "likes, shares, money and hours count only under campaign verification rules"
  },
  "team_contribution": {
    "supported": true,
    "subjects": [
      "team",
      "company",
      "community"
    ],
    "aggregation": "verified contributions only"
  },
  "portable_profile": {
    "cross_organization": true,
    "default_visibility": "private",
    "ownership": "contributor",
    "rule": "one contribution history can span organizations without becoming a coercive identity score"
  },
  "cause_graph": {
    "primary_navigation": "cause_not_organization",
    "nodes": [
      "cause",
      "campaign",
      "organization",
      "need",
      "action",
      "impact"
    ],
    "rule": "people may follow problems and outcomes rather than donor brands"
  },
  "matching_engine": {
    "objective": "smallest_relevant_action_now",
    "inputs": [
      "cause_interest",
      "current_need",
      "location",
      "availability",
      "skills",
      "privacy_preferences"
    ],
    "rule": "recommend proportionate actions; do not optimize for engagement alone"
  },
  "open_impact_api": {
    "purpose": "interoperability without forcing system migration",
    "integrates_with": [
      "crm",
      "payment",
      "volunteer_system",
      "campaign_system",
      "identity_provider",
      "analytics"
    ],
    "exposes": [
      "campaign_contract",
      "accepted_actions",
      "verification_status",
      "impact_receipt",
      "impact_summary"
    ]
  },
  "micro_actions": {
    "principle": "low effort can create high impact when the action is relevant to a verified need",
    "scoring_rule": "no impact credit without relevance and evidence",
    "catalog": [
      {
        "id": "follow_profile",
        "unit": "verified_follow",
        "examples": [
          "follow a relevant organization profile",
          "subscribe to updates"
        ]
      },
      {
        "id": "share_verified_content",
        "unit": "verified_share",
        "examples": [
          "share a verified campaign",
          "forward a concrete call to action"
        ]
      },
      {
        "id": "answer_survey",
        "unit": "completed_response",
        "examples": [
          "answer one survey",
          "provide one useful data point"
        ]
      },
      {
        "id": "introduce_contact",
        "unit": "verified_connection",
        "examples": [
          "introduce one relevant person",
          "connect an employer or decision-maker"
        ]
      },
      {
        "id": "five_minute_task",
        "unit": "verified_task",
        "examples": [
          "translate a paragraph",
          "check one fact",
          "tag one resource",
          "make one local call"
        ]
      },
      {
        "id": "attend_local",
        "unit": "verified_presence",
        "examples": [
          "attend a short local event",
          "show up for a concrete task"
        ]
      },
      {
        "id": "offer_transport",
        "unit": "verified_delivery",
        "examples": [
          "drive one person",
          "move one needed item"
        ]
      },
      {
        "id": "donate_item",
        "unit": "accepted_resource",
        "examples": [
          "donate unused equipment",
          "lend space or tools"
        ]
      }
    ]
  },
  "need_feed": {
    "need_first": true,
    "fields": [
      "need_id",
      "cause_id",
      "organization_id",
      "title",
      "description",
      "location",
      "remote",
      "deadline",
      "priority",
      "accepted_contribution_types",
      "verification_rule",
      "evidence_required",
      "status",
      "updated_at"
    ],
    "rules": [
      "publish concrete needs, not generic engagement requests",
      "expire or close needs when no longer active",
      "show who verifies completion",
      "do not claim impact before evidence"
    ]
  },
  "action_marketplace": {
    "matching_engine": "smallest_relevant_action",
    "effect_gated": true,
    "matching_inputs": [
      "need",
      "location",
      "availability_minutes",
      "skills",
      "capacity",
      "privacy_preferences"
    ],
    "action_types": [
      "one_click_help",
      "skill_ping",
      "micro_volunteering",
      "introduction",
      "local_relay",
      "resource_lending",
      "employer_action",
      "verified_witness",
      "translation_relay",
      "recurring_micro_action",
      "unused_capacity"
    ],
    "rules": [
      "match a documented need before proposing an action",
      "prefer the smallest sufficient useful action",
      "verify completion separately from impact",
      "no impact credit for irrelevant activity"
    ]
  }
}
